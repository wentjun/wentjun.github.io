{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Travel record",
  "type": "object",
  "additionalProperties": false,
  "required": ["currentLocation", "visits"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "currentLocation": {
      "$ref": "#/$defs/place",
      "description": "Where you are now. Updating visits does not change this."
    },
    "visits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/visit"
      },
      "description": "Past visits and future plans. Display order is automatically newest first."
    }
  },
